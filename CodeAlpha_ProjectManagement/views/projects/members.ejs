<%- include('../partials/header') %>

<div class="mx-auto max-w-3xl">

    <!-- Back to Project -->
    <a
        class="text-sm font-medium text-indigo-600"
        href="/projects/<%= project._id %>"
    >
        ← <%= project.name %>
    </a>


    <!-- Page Heading -->
    <h1 class="mt-4 text-3xl font-bold">
        Project members
    </h1>

    <p class="mt-2 text-slate-600">
        Only members can access this project and be assigned tasks.
    </p>


    <!-- Add Member Form -->
    <% if (canManage) { %>

        <form
            class="mt-6 flex gap-3 rounded-xl border border-slate-200 bg-white p-4"
            action="/projects/<%= project._id %>/members"
            method="POST"
        >

            <!-- Member Email -->
            <input
                class="min-w-0 flex-1 rounded-lg border border-slate-300 px-3 py-2"
                name="email"
                type="email"
                placeholder="Teammate email"
                required
            >

            <!-- Add Member Button -->
            <button
                type="submit"
                class="rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white"
            >
                Add member
            </button>

        </form>

    <% } %>


    <!-- Members List -->
    <div class="mt-5 divide-y rounded-xl border border-slate-200 bg-white">

        <% project.members.forEach(member => { %>

            <div class="flex items-center justify-between gap-4 p-4">

                <!-- Member Information -->
                <div>

                    <p class="font-semibold">

                        <%= member.name %>

                        <!-- Show Owner Label -->
                        <%= project.owner._id.equals(member._id) ? '(Owner)' : '' %>

                    </p>

                    <p class="text-sm text-slate-500">
                        <%= member.email %>
                    </p>

                </div>


                <!-- Remove Member -->
                <% if (
                    canManage &&
                    !project.owner._id.equals(member._id)
                ) { %>

                    <form
                        action="/projects/<%= project._id %>/members/<%= member._id %>/delete"
                        method="POST"
                    >

                        <button
                            type="submit"
                            class="text-sm font-semibold text-rose-600"
                        >
                            Remove
                        </button>

                    </form>

                <% } %>

            </div>

        <% }) %>

    </div>

</div>

<%- include('../partials/footer') %>