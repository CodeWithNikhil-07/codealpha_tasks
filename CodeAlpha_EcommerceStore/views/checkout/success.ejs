<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Order Confirmed | Ecommerce Store</title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="min-h-screen bg-emerald-50 text-slate-900">

    <!-- HEADER -->

    <header class="bg-white border-b border-emerald-100">

        <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between">

            <a
                href="/products"
                class="text-xl font-black tracking-tight"
            >
                ECOMMERCE<span class="text-emerald-600">.</span>
            </a>

            <div class="flex items-center gap-5 text-sm">

                <a
                    href="/products"
                    class="text-slate-500 hover:text-emerald-600 transition"
                >
                    Shop
                </a>

                <a
                    href="/orders"
                    class="text-slate-500 hover:text-emerald-600 transition"
                >
                    My Orders
                </a>

            </div>

        </div>

    </header>


    <!-- MAIN -->

    <main class="max-w-4xl mx-auto px-6 py-12">

        <!-- SUCCESS MESSAGE -->

        <div class="bg-white rounded-3xl shadow-sm border border-emerald-100 p-8 md:p-12 text-center">

            <!-- SUCCESS ICON -->

            <div class="mx-auto w-20 h-20 rounded-full bg-emerald-100 flex items-center justify-center">

                <span class="text-4xl">
                    ✓
                </span>

            </div>


            <p class="mt-6 text-sm font-bold uppercase tracking-[0.2em] text-emerald-600">
                Order Confirmed
            </p>


            <h1 class="text-4xl font-black mt-2">
                Thank You!
            </h1>


            <p class="text-slate-500 mt-3">
                Your order has been placed successfully.
            </p>


            <h2 class="text-xl font-semibold mt-6">
                Thank you for your order,
                <span class="text-emerald-600">
                    <%= order.shippingAddress.name %>
                </span>!
            </h2>


            <!-- ORDER DETAILS -->

            <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-4 text-left">

                <div class="bg-slate-50 rounded-xl p-5">

                    <p class="text-xs uppercase tracking-wider text-slate-500">
                        Order ID
                    </p>

                    <p class="font-semibold mt-2 break-all text-sm">
                        <%= order._id %>
                    </p>

                </div>


                <div class="bg-slate-50 rounded-xl p-5">

                    <p class="text-xs uppercase tracking-wider text-slate-500">
                        Total Amount
                    </p>

                    <p class="font-bold text-xl mt-1">
                        ₹<%= order.totalAmount %>
                    </p>

                </div>


                <div class="bg-slate-50 rounded-xl p-5">

                    <p class="text-xs uppercase tracking-wider text-slate-500">
                        Payment Method
                    </p>

                    <p class="font-semibold mt-2">
                        <%= order.paymentMethod %>
                    </p>

                </div>

            </div>


            <!-- ORDER STATUS -->

            <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-3">

                <span class="text-sm text-slate-500">
                    Order Status:
                </span>

                <span class="px-4 py-2 rounded-full bg-amber-100 text-amber-700 text-sm font-bold">
                    <%= order.orderStatus %>
                </span>

            </div>

        </div>


        <!-- ORDER ITEMS -->

        <div class="bg-white rounded-3xl shadow-sm border border-emerald-100 p-8 mt-8">

            <div class="flex items-center justify-between mb-7">

                <div>

                    <p class="text-xs uppercase tracking-[0.2em] text-emerald-600 font-bold">
                        Your Purchase
                    </p>

                    <h2 class="text-2xl font-black mt-1">
                        Order Items
                    </h2>

                </div>

                <span class="text-sm text-slate-500">
                    <%= order.items.length %> item(s)
                </span>

            </div>


            <div class="space-y-5">

                <% order.items.forEach(item => { %>

                    <div class="flex items-center justify-between gap-5 pb-5 border-b border-slate-100">

                        <div>

                            <h3 class="font-bold text-lg">
                                <%= item.name %>
                            </h3>

                            <p class="text-sm text-slate-500 mt-1">
                                ₹<%= item.price %>
                                ×
                                <%= item.quantity %>
                            </p>

                        </div>


                        <div class="text-right">

                            <p class="text-xs text-slate-500">
                                Quantity
                            </p>

                            <p class="font-semibold">
                                <%= item.quantity %>
                            </p>

                        </div>

                    </div>

                <% }) %>

            </div>


            <!-- TOTAL -->

            <div class="flex justify-between items-center mt-7">

                <span class="text-lg font-semibold">
                    Total Paid
                </span>

                <span class="text-2xl font-black text-emerald-600">
                    ₹<%= order.totalAmount %>
                </span>

            </div>

        </div>


        <!-- ACTIONS -->

        <div class="flex flex-col sm:flex-row justify-center gap-4 mt-8">

            <a
                href="/orders"
                class="px-7 py-3.5 rounded-xl bg-slate-900 text-white font-bold text-center hover:bg-slate-700 transition"
            >
                View My Orders
            </a>


            <a
                href="/products"
                class="px-7 py-3.5 rounded-xl bg-white border border-slate-300 text-slate-900 font-bold text-center hover:bg-slate-50 transition"
            >
                Continue Shopping
            </a>

        </div>

    </main>

</body>

</html>