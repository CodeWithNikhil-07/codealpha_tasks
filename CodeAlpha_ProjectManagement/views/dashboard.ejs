<%- include('partials/header') %>

<!-- Workspace Header -->
<div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">

    <div>
        <p class="text-sm font-semibold text-indigo-600">
            WORKSPACE
        </p>

        <h1 class="mt-1 text-3xl font-bold tracking-tight">
            Welcome, <%= user.name %>
        </h1>

        <p class="mt-2 text-slate-600">
            Keep projects, tasks, and conversations in one place.
        </p>
    </div>

    <!-- Create Project -->
    <a
        href="/projects/create"
        class="rounded-lg bg-indigo-600 px-4 py-2.5 text-center font-semibold text-white shadow-sm hover:bg-indigo-700"
    >
        + New project
    </a>

</div>


<!-- Task Statistics -->
<div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-3">

    <% [
        ['To do', counts.todo, 'bg-amber-50 text-amber-700'],
        ['In progress', counts['in-progress'], 'bg-blue-50 text-blue-700'],
        ['Completed', counts.completed, 'bg-emerald-50 text-emerald-700']
    ].forEach(([label, count, style]) => { %>

        <div class="rounded-xl border border-slate-200 bg-white p-5">

            <p class="text-sm text-slate-500">
                <%= label %> tasks
            </p>

            <p class="mt-1 text-3xl font-bold <%= style %>">
                <%= count %>
            </p>

        </div>

    <% }) %>

</div>


<!-- Project Filters -->
<form
    class="mb-6 grid gap-3 rounded-xl border border-slate-200 bg-white p-4 sm:grid-cols-[1fr_180px_auto]"
    method="GET"
>

    <!-- Search Projects -->
    <input
        class="rounded-lg border border-slate-300 px-3 py-2"
        type="text"
        name="q"
        value="<%= filters.q %>"
        placeholder="Search projects"
    >


    <!-- Project Status -->
    <select
        class="rounded-lg border border-slate-300 px-3 py-2"
        name="status"
    >

        <option value="">
            All statuses
        </option>

        <% ['active', 'completed', 'archived'].forEach(status => { %>

            <option
                value="<%= status %>"
                <%= filters.status === status ? 'selected' : '' %>
            >
                <%= status[0].toUpperCase() + status.slice(1) %>
            </option>

        <% }) %>

    </select>


    <!-- Filter Button -->
    <button
        type="submit"
        class="rounded-lg bg-slate-800 px-4 py-2 font-medium text-white"
    >
        Filter
    </button>

</form>


<!-- Projects -->
<% if (!projects.length) { %>

    <!-- No Projects -->
    <div
        class="rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center"
    >

        <h2 class="text-lg font-semibold">
            No projects found
        </h2>

        <p class="mt-1 text-slate-500">
            Create your first project or adjust the filters.
        </p>

    </div>

<% } else { %>

    <!-- Project Cards -->
    <div class="grid gap-4 md:grid-cols-2">

        <% projects.forEach(project => { %>

            <a
                href="/projects/<%= project._id %>"
                class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow"
            >

                <div class="flex items-start justify-between gap-3">

                    <!-- Project Name -->
                    <h2 class="font-bold text-slate-900">
                        <%= project.name %>
                    </h2>


                    <!-- Project Status -->
                    <span
                        class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-semibold text-indigo-700"
                    >
                        <%= project.status %>
                    </span>

                </div>


                <!-- Project Description -->
                <p class="mt-3 line-clamp-2 text-sm text-slate-600">
                    <%= project.description || 'No description yet.' %>
                </p>


                <!-- Project Owner -->
                <p class="mt-4 text-xs text-slate-400">
                    Owner · <%= project.owner.name %>
                </p>

            </a>

        <% }) %>

    </div>

<% } %>


<%- include('partials/footer') %>