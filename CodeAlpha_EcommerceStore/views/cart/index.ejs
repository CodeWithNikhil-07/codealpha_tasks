<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Your Cart | Ecommerce Store</title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="min-h-screen bg-stone-100 text-stone-900">

    <!-- CART HEADER -->

    <header class="bg-stone-900 text-white">

        <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between">

            <a
                href="/products"
                class="text-xl font-bold tracking-wide"
            >
                🛍️ Ecommerce Store
            </a>

            <div class="flex items-center gap-5 text-sm">

                <a
                    href="/products"
                    class="text-stone-300 hover:text-white transition"
                >
                    Continue Shopping
                </a>

                <a
                    href="/orders"
                    class="text-stone-300 hover:text-white transition"
                >
                    My Orders
                </a>

                <a
                    href="/logout"
                    class="text-red-400 hover:text-red-300 transition"
                >
                    Logout
                </a>

            </div>

        </div>

    </header>


    <!-- MAIN -->

    <main class="max-w-6xl mx-auto px-6 py-10">

        <!-- PAGE TITLE -->

        <div class="mb-8">

            <p class="text-sm uppercase tracking-[0.25em] text-stone-500">
                Shopping Bag
            </p>

            <h1 class="text-4xl font-bold mt-2">
                Your Cart
            </h1>

        </div>


        <% if (cart.items.length === 0) { %>

            <!-- EMPTY CART -->

            <div class="bg-white rounded-2xl shadow-sm border border-stone-200 p-12 text-center">

                <div class="text-6xl mb-5">
                    🛒
                </div>

                <h2 class="text-2xl font-bold mb-3">
                    Your cart is empty
                </h2>

                <p class="text-stone-500 mb-7">
                    Looks like you haven't added anything yet.
                </p>

                <a
                    href="/products"
                    class="inline-block bg-stone-900 text-white px-7 py-3 rounded-lg font-semibold hover:bg-stone-700 transition"
                >
                    Continue Shopping
                </a>

            </div>


        <% } else { %>


            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

                <!-- CART ITEMS -->

                <div class="lg:col-span-2 space-y-5">

                    <% cart.items.forEach(item => { %>

                        <% if (item.product) { %>

                            <div class="bg-white rounded-2xl border border-stone-200 shadow-sm p-5">

                                <div class="flex flex-col sm:flex-row gap-6">

                                    <!-- PRODUCT IMAGE -->

                                    <div class="w-full sm:w-40 h-40 bg-stone-100 rounded-xl overflow-hidden flex-shrink-0">

                                        <% if (item.product.imageUrl) { %>

                                            <img
                                                src="<%= item.product.imageUrl %>"
                                                alt="<%= item.product.name %>"
                                                class="w-full h-full object-cover"
                                            >

                                        <% } else { %>

                                            <div class="w-full h-full flex items-center justify-center text-stone-400">
                                                No Image
                                            </div>

                                        <% } %>

                                    </div>


                                    <!-- PRODUCT INFORMATION -->

                                    <div class="flex-1">

                                        <div class="flex flex-col sm:flex-row sm:justify-between gap-3">

                                            <div>

                                                <p class="text-xs uppercase tracking-wider text-stone-500 mb-1">
                                                    <%= item.product.category %>
                                                </p>

                                                <h2 class="text-xl font-bold">
                                                    <%= item.product.name %>
                                                </h2>

                                            </div>

                                            <p class="text-xl font-bold">
                                                ₹<%= item.product.price %>
                                            </p>

                                        </div>


                                        <!-- QUANTITY -->

                                        <div class="mt-6 flex items-center gap-4">

                                            <span class="text-sm font-semibold text-stone-600">
                                                Quantity
                                            </span>

                                            <div class="flex items-center border border-stone-300 rounded-lg overflow-hidden">

                                                <form
                                                    action="/cart/decrease/<%= item.product._id %>"
                                                    method="POST"
                                                >

                                                    <button
                                                        type="submit"
                                                        class="w-10 h-10 text-lg hover:bg-stone-100 transition"
                                                    >
                                                        −
                                                    </button>

                                                </form>


                                                <span class="w-12 text-center font-semibold">
                                                    <%= item.quantity %>
                                                </span>


                                                <form
                                                    action="/cart/increase/<%= item.product._id %>"
                                                    method="POST"
                                                >

                                                    <button
                                                        type="submit"
                                                        class="w-10 h-10 text-lg hover:bg-stone-100 transition"
                                                    >
                                                        +
                                                    </button>

                                                </form>

                                            </div>

                                        </div>


                                        <!-- ITEM TOTAL + REMOVE -->

                                        <div class="mt-6 flex items-center justify-between">

                                            <p class="text-sm text-stone-500">
                                                Item Total:
                                                <span class="font-bold text-stone-900">
                                                    ₹<%= item.product.price * item.quantity %>
                                                </span>
                                            </p>


                                            <form
                                                action="/cart/remove/<%= item.product._id %>"
                                                method="POST"
                                            >

                                                <button
                                                    type="submit"
                                                    class="text-sm text-red-600 hover:text-red-800 font-semibold transition"
                                                >
                                                    Remove
                                                </button>

                                            </form>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        <% } %>

                    <% }) %>

                </div>


                <!-- ORDER SUMMARY -->

                <div>

                    <div class="bg-stone-900 text-white rounded-2xl p-7 sticky top-6">

                        <p class="text-sm uppercase tracking-[0.2em] text-stone-400">
                            Order Summary
                        </p>

                        <h2 class="text-2xl font-bold mt-2 mb-7">
                            Your Total
                        </h2>


                        <div class="flex justify-between text-stone-300 mb-4">

                            <span>
                                Subtotal
                            </span>

                            <span>
                                ₹<%= subtotal %>
                            </span>

                        </div>


                        <div class="flex justify-between text-stone-300 mb-5">

                            <span>
                                Shipping
                            </span>

                            <span class="text-green-400">
                                Free
                            </span>

                        </div>


                        <div class="border-t border-stone-700 pt-5 flex justify-between">

                            <span class="text-lg font-semibold">
                                Total
                            </span>

                            <span class="text-2xl font-bold">
                                ₹<%= subtotal %>
                            </span>

                        </div>


                        <!-- CHECKOUT -->

                        <a
                            href="/checkout"
                            class="block text-center bg-white text-stone-900 py-3.5 rounded-xl mt-7 font-bold hover:bg-stone-200 transition"
                        >
                            Proceed to Checkout →
                        </a>


                        <!-- CONTINUE SHOPPING -->

                        <a
                            href="/products"
                            class="block text-center text-stone-400 mt-5 text-sm hover:text-white transition"
                        >
                            ← Continue Shopping
                        </a>

                    </div>

                </div>

            </div>

        <% } %>

    </main>

</body>

</html>