<%- include('partials/header') %>

<div class="mx-auto max-w-xl rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">

    <!-- Status Code -->
    <p class="text-5xl font-bold text-indigo-600">
        <%= status %>
    </p>

    <!-- Page Title -->
    <h1 class="mt-3 text-2xl font-bold">
        <%= title %>
    </h1>

    <!-- Message -->
    <p class="mt-2 text-slate-600">
        <%= message %>
    </p>

    <!-- Back Button -->
    <a
        class="mt-6 inline-block rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white"
        href="<%= currentUser ? '/dashboard' : '/auth/login' %>"
    >
        Go back
    </a>

</div>

<%- include('partials/footer') %>