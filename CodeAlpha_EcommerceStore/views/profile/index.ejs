<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>My Profile | Ecommerce Store</title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="min-h-screen bg-zinc-100 text-zinc-900">

    <!-- HEADER -->

    <header class="bg-zinc-950 text-white">

        <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between">

            <a
                href="/products"
                class="text-xl font-black tracking-tight"
            >
                ECOMMERCE<span class="text-violet-400">.</span>
            </a>

            <nav class="flex items-center gap-5 text-sm">

                <a
                    href="/products"
                    class="text-zinc-400 hover:text-white transition"
                >
                    Shop
                </a>

                <a
                    href="/orders"
                    class="text-zinc-400 hover:text-white transition"
                >
                    My Orders
                </a>

                <a
                    href="/cart"
                    class="text-zinc-400 hover:text-white transition"
                >
                    🛒 Cart
                </a>

            </nav>

        </div>

    </header>


    <!-- MAIN -->

    <main class="max-w-5xl mx-auto px-6 py-10">

        <!-- PROFILE HEADER -->

        <div class="mb-8">

            <p class="text-xs uppercase tracking-[0.25em] text-violet-600 font-bold">
                Account Settings
            </p>

            <h1 class="text-4xl font-black mt-2">
                My Profile
            </h1>

            <p class="text-zinc-500 mt-2">
                Manage your personal information and delivery details.
            </p>

        </div>


        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">


            <!-- PROFILE SIDEBAR -->

            <aside>

                <div class="bg-zinc-950 text-white rounded-3xl p-7 shadow-lg">

                    <!-- AVATAR -->

                    <div class="w-20 h-20 rounded-2xl bg-violet-500 flex items-center justify-center text-3xl font-black mb-5">
                        <%= user.name.charAt(0).toUpperCase() %>
                    </div>


                    <h2 class="text-2xl font-black">
                        <%= user.name %>
                    </h2>

                    <p class="text-zinc-400 text-sm mt-1 break-all">
                        <%= user.email %>
                    </p>


                    <div class="border-t border-zinc-800 my-6"></div>


                    <div class="space-y-3 text-sm">

                        <a
                            href="/profile"
                            class="block px-4 py-3 rounded-xl bg-violet-500 font-bold"
                        >
                            👤 Profile
                        </a>

                        <a
                            href="/orders"
                            class="block px-4 py-3 rounded-xl text-zinc-400 hover:bg-zinc-800 hover:text-white transition"
                        >
                            📦 My Orders
                        </a>

                        <a
                            href="/cart"
                            class="block px-4 py-3 rounded-xl text-zinc-400 hover:bg-zinc-800 hover:text-white transition"
                        >
                            🛒 My Cart
                        </a>

                        <a
                            href="/products"
                            class="block px-4 py-3 rounded-xl text-zinc-400 hover:bg-zinc-800 hover:text-white transition"
                        >
                            🛍 Continue Shopping
                        </a>

                    </div>

                </div>

            </aside>


            <!-- PROFILE FORM -->

            <section class="lg:col-span-2">

                <div class="bg-white rounded-3xl border border-zinc-200 shadow-sm p-7 md:p-9">

                    <div class="mb-8">

                        <h2 class="text-2xl font-black">
                            Personal Information
                        </h2>

                        <p class="text-zinc-500 text-sm mt-1">
                            Keep your information up to date for a smooth checkout experience.
                        </p>

                    </div>


                    <form
                        action="/profile/update"
                        method="POST"
                        class="space-y-6"
                    >


                        <!-- NAME -->

                        <div>

                            <label
                                for="name"
                                class="block text-sm font-bold mb-2"
                            >
                                Full Name
                            </label>

                            <input
                                type="text"
                                id="name"
                                name="name"
                                value="<%= user.name %>"
                                required
                                class="w-full px-4 py-3.5 rounded-xl border border-zinc-300 bg-zinc-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-transparent transition"
                            >

                        </div>


                        <!-- EMAIL -->

                        <div>

                            <label
                                for="email"
                                class="block text-sm font-bold mb-2"
                            >
                                Email Address
                            </label>

                            <input
                                type="email"
                                id="email"
                                value="<%= user.email %>"
                                disabled
                                class="w-full px-4 py-3.5 rounded-xl border border-zinc-200 bg-zinc-100 text-zinc-500 cursor-not-allowed"
                            >

                            <p class="text-xs text-zinc-400 mt-2">
                                Email address cannot be changed.
                            </p>

                        </div>


                        <!-- PHONE -->

                        <div>

                            <label
                                for="phone"
                                class="block text-sm font-bold mb-2"
                            >
                                Phone Number
                            </label>

                            <input
                                type="text"
                                id="phone"
                                name="phone"
                                value="<%= user.phone || '' %>"
                                placeholder="Enter your phone number"
                                class="w-full px-4 py-3.5 rounded-xl border border-zinc-300 bg-zinc-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-transparent transition"
                            >

                        </div>


                        <!-- ADDRESS -->

                        <div>

                            <label
                                for="address"
                                class="block text-sm font-bold mb-2"
                            >
                                Address
                            </label>

                            <textarea
                                id="address"
                                name="address"
                                rows="4"
                                placeholder="Enter your complete address"
                                class="w-full px-4 py-3.5 rounded-xl border border-zinc-300 bg-zinc-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-transparent transition resize-none"
                            ><%= user.address || '' %></textarea>

                        </div>


                        <!-- CITY + STATE -->

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                            <div>

                                <label
                                    for="city"
                                    class="block text-sm font-bold mb-2"
                                >
                                    City
                                </label>

                                <input
                                    type="text"
                                    id="city"
                                    name="city"
                                    value="<%= user.city || '' %>"
                                    placeholder="Enter city"
                                    class="w-full px-4 py-3.5 rounded-xl border border-zinc-300 bg-zinc-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-transparent transition"
                                >

                            </div>


                            <div>

                                <label
                                    for="state"
                                    class="block text-sm font-bold mb-2"
                                >
                                    State
                                </label>

                                <input
                                    type="text"
                                    id="state"
                                    name="state"
                                    value="<%= user.state || '' %>"
                                    placeholder="Enter state"
                                    class="w-full px-4 py-3.5 rounded-xl border border-zinc-300 bg-zinc-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-transparent transition"
                                >

                            </div>

                        </div>


                        <!-- PINCODE -->

                        <div>

                            <label
                                for="pincode"
                                class="block text-sm font-bold mb-2"
                            >
                                Pincode
                            </label>

                            <input
                                type="text"
                                id="pincode"
                                name="pincode"
                                value="<%= user.pincode || '' %>"
                                placeholder="Enter pincode"
                                class="w-full px-4 py-3.5 rounded-xl border border-zinc-300 bg-zinc-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-transparent transition"
                            >

                        </div>


                        <!-- SUBMIT -->

                        <div class="pt-4 border-t border-zinc-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">

                            <p class="text-xs text-zinc-400">
                                Your information is used for order delivery.
                            </p>

                            <button
                                type="submit"
                                class="px-7 py-3.5 bg-violet-600 text-white rounded-xl font-bold hover:bg-violet-700 transition shadow-md"
                            >
                                Save Changes
                            </button>

                        </div>

                    </form>

                </div>

            </section>

        </div>

    </main>


    <!-- FOOTER -->

    <footer class="border-t border-zinc-200 bg-white mt-10">

        <div class="max-w-6xl mx-auto px-6 py-7 text-center">

            <p class="text-sm text-zinc-400">
                © 2026 Ecommerce Store
            </p>

        </div>

    </footer>

</body>

</html>