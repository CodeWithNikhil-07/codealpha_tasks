<%- include('../partials/header') %>

<!-- Project Header -->
<div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">

    <!-- Project Information -->
    <div>

        <!-- Back to Dashboard -->
        <a
            class="text-sm font-medium text-indigo-600"
            href="/dashboard"
        >
            ← Dashboard
        </a>

        <!-- Project Name -->
        <h1 class="mt-3 text-3xl font-bold">
            <%= project.name %>
        </h1>

        <!-- Project Description -->
        <p class="mt-2 max-w-2xl text-slate-600">
            <%= project.description || 'No description yet.' %>
        </p>

        <!-- Project Owner and Status -->
        <p class="mt-3 text-sm text-slate-500">
            Owner · <%= project.owner.name %> · <%= project.status %>
        </p>

    </div>

    <!-- Project Actions -->
    <div class="flex flex-wrap gap-2">

        <!-- Members -->
        <a
            class="rounded-lg border border-slate-300 px-3 py-2 font-medium"
            href="/projects/<%= project._id %>/members"
        >
            Members (<%= project.members.length %>)
        </a>

        <!-- Create Task -->
        <a
            class="rounded-lg bg-indigo-600 px-3 py-2 font-semibold text-white"
            href="/projects/<%= project._id %>/tasks/create"
        >
            + Task
        </a>

        <!-- Edit Project -->
        <% if (canManage) { %>

            <a
                class="rounded-lg border border-slate-300 px-3 py-2 font-medium"
                href="/projects/<%= project._id %>/edit"
            >
                Edit
            </a>

        <% } %>

    </div>

</div>

<!-- Tasks Section -->
<section class="mt-8">

    <!-- Tasks Heading -->
    <div class="flex items-center justify-between">

        <h2 class="text-xl font-bold">
            Tasks
        </h2>

        <span class="text-sm text-slate-500">
            <%= tasks.length %> shown
        </span>

    </div>

    <!-- Task Filters -->
    <form
        class="mt-4 grid gap-3 rounded-xl border border-slate-200 bg-white p-4 sm:grid-cols-4"
        method="GET"
    >

        <!-- Search -->
        <input
            class="rounded-lg border border-slate-300 px-3 py-2"
            type="text"
            name="q"
            value="<%= filters.q %>"
            placeholder="Search tasks"
        >

        <!-- Task Status -->
        <select
            class="rounded-lg border border-slate-300 px-3 py-2"
            name="taskStatus"
        >

            <option value="">
                All statuses
            </option>

            <% ['todo', 'in-progress', 'completed'].forEach(status => { %>

                <option
                    value="<%= status %>"
                    <%= filters.taskStatus === status ? 'selected' : '' %>
                >
                    <%= status %>
                </option>

            <% }) %>

        </select>

        <!-- Priority -->
        <select
            class="rounded-lg border border-slate-300 px-3 py-2"
            name="priority"
        >

            <option value="">
                All priorities
            </option>

            <% ['low', 'medium', 'high'].forEach(priority => { %>

                <option
                    value="<%= priority %>"
                    <%= filters.priority === priority ? 'selected' : '' %>
                >
                    <%= priority %>
                </option>

            <% }) %>

        </select>

        <!-- Filter Button -->
        <button
            type="submit"
            class="rounded-lg bg-slate-800 px-4 py-2 font-medium text-white"
        >
            Filter
        </button>

    </form>

    <!-- Task List -->
    <div class="mt-4 space-y-3">

        <!-- No Tasks Message -->
        <% if (!tasks.length) { %>

            <div
                class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500"
            >
                No tasks match these filters.
            </div>

        <% } %>

        <!-- Display Tasks -->
        <% tasks.forEach(task => { %>

            <a
                class="block rounded-xl border border-slate-200 bg-white p-4 shadow-sm hover:border-indigo-300"
                href="/tasks/<%= task._id %>"
            >

                <div class="flex flex-wrap items-start justify-between gap-3">

                    <!-- Task Information -->
                    <div>

                        <!-- Task Title -->
                        <h3 class="font-bold">
                            <%= task.title %>
                        </h3>

                        <!-- Assigned User -->
                        <p class="mt-1 text-sm text-slate-500">
                            <%= task.assignedTo
                                ? `Assigned to ${task.assignedTo.name}`
                                : 'Unassigned'
                            %>
                        </p>

                    </div>

                    <!-- Task Status and Priority -->
                    <div class="flex gap-2 text-xs font-semibold">

                        <!-- Status -->
                        <span class="rounded-full bg-slate-100 px-2.5 py-1">
                            <%= task.status %>
                        </span>

                        <!-- Priority -->
                        <span
                            class="rounded-full bg-amber-50 px-2.5 py-1 text-amber-700"
                        >
                            <%= task.priority %>
                        </span>

                    </div>

                </div>

            </a>

        <% }) %>

    </div>

</section>

<!-- Delete Project -->
<% if (canManage) { %>

    <form
        class="mt-8"
        action="/projects/<%= project._id %>/delete"
        method="POST"
        onsubmit="return confirm('Delete this project and every task and comment in it?')"
    >

        <button
            type="submit"
            class="text-sm font-semibold text-rose-600"
        >
            Delete project
        </button>

    </form>

<% } %>

<%- include('../partials/footer') %>