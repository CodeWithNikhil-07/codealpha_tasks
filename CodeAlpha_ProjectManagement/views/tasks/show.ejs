<%- include('../partials/header') %>

<a class="text-sm font-medium text-indigo-600" href="/projects/<%= task.project._id %>">
  ← <%= task.project.name %>
</a>


<div class="mt-4 flex flex-col justify-between gap-4 sm:flex-row">

  <!-- Task Information -->
  <div>

    <!-- Task Title -->
    <h1 class="text-3xl font-bold">
      <%= task.title %>
    </h1>

    <!-- Task Description -->
    <p class="mt-3 max-w-2xl text-slate-600">
      <%= task.description || 'No description provided.' %>
    </p>

  </div>


  <!-- Edit / Delete Buttons -->
  <% if (canEdit) { %>

  <div class="flex h-fit gap-2">

    <!-- Edit Task -->
    <a class="rounded-lg border border-slate-300 px-3 py-2 font-medium" href="/tasks/<%= task._id %>/edit">
      Edit task
    </a>


    <!-- Delete Task -->
    <form action="/tasks/<%= task._id %>/delete" method="POST" onsubmit="return confirm('Delete this task and its comments?')">

      <button type="submit" class="rounded-lg border border-rose-200 px-3 py-2 font-semibold text-rose-600">
        Delete
      </button>

    </form>

  </div>

  <% } %>

</div>


<div class="mt-7 grid gap-4 sm:grid-cols-4">

  <% [
        ['Status', task.status],
        ['Priority', task.priority],
        [
            'Assigned to',
            task.assignedTo
                ? task.assignedTo.name
                : 'Unassigned'
        ],
        [
            'Due date',
            task.dueDate
                ? task.dueDate.toLocaleDateString()
                : 'No due date'
        ]
    ].forEach(item => { %>


  <!-- Information Card -->
  <div class="rounded-xl border border-slate-200 bg-white p-4">

    <!-- Label -->
    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
      <%= item[0] %>
    </p>


    <!-- Value -->
    <p class="mt-2 font-semibold">
      <%= item[1] %>
    </p>

  </div>


  <% }) %>

</div>


<section id="comments" class="mt-9 max-w-3xl">

  <!-- Section Heading -->
  <h2 class="text-xl font-bold">
    Discussion
  </h2>


  <!-- Add Comment Form -->
  <form class="mt-4 rounded-xl border border-slate-200 bg-white p-4" action="/tasks/<%= task._id %>/comments" method="POST">

    <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2" name="text" rows="3" maxlength="2000" placeholder="Write a comment…" required></textarea>


    <!-- Post Comment Button -->
    <button type="submit" class="mt-3 rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white">
      Post comment
    </button>

  </form>


  <div class="mt-4 space-y-3">

    <!-- No Comments -->
    <% if (!comments.length) { %>

    <p class="text-slate-500">
      No comments yet. Start the discussion.
    </p>

    <% } %>


    <!-- Display Comments -->
    <% comments.forEach(comment => { %>

    <article class="rounded-xl border border-slate-200 bg-white p-4">

      <div class="flex justify-between gap-4">

        <!-- Comment Author -->
        <div>

          <p class="font-semibold">
            <%= comment.author.name %>
          </p>

          <p class="text-xs text-slate-400">
            <%= comment.createdAt.toLocaleString() %>
          </p>

        </div>


        <!-- Delete Comment -->
        <% if (
                        comment.author._id.equals(currentUser._id) ||
                        canManage
                    ) { %>

        <form action="/comments/<%= comment._id %>/delete" method="POST">

          <button type="submit" class="text-sm font-semibold text-rose-600">
            Delete
          </button>

        </form>

        <% } %>

      </div>


      <!-- Comment Text -->
      <p class="mt-3 whitespace-pre-wrap text-slate-700">
        <%= comment.text %>
      </p>

    </article>

    <% }) %>

  </div>

</section>


<%- include('../partials/footer') %>