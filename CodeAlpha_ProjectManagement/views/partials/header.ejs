<!DOCTYPE html>
<html lang="en">

<head>

    <!-- Basic HTML Settings -->
    <meta charset="UTF-8">

    <!-- Makes the website responsive -->
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <!-- Dynamic Page Title -->
    <title>
        <%= title ? `${title} · Flowboard` : "Flowboard" %>
    </title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Custom Tailwind Configuration -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        ink: '#172554',
                        brand: '#4f46e5'
                    }
                }
            }
        }
    </script>

</head>

<body class="min-h-screen bg-slate-50 text-slate-800">

    <!-- =========================
         HEADER / NAVBAR
         ========================= -->

    <header class="border-b border-slate-200 bg-white">

        <div
            class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6"
        >

            <!-- Flowboard Logo -->
            <a
                href="<%= currentUser ? '/dashboard' : '/auth/login' %>"
                class="text-xl font-bold tracking-tight text-indigo-600"
            >
                Flowboard
            </a>


            <!-- Show Navigation Only When User Is Logged In -->
            <% if (currentUser) { %>

                <nav class="flex items-center gap-3 text-sm">

                    <!-- Dashboard Link -->
                    <a
                        href="/dashboard"
                        class="font-medium text-slate-600 hover:text-indigo-600"
                    >
                        Dashboard
                    </a>

                    <!-- Logged-in User's Name -->
                    <span class="hidden text-slate-400 sm:inline">
                        <%= currentUser.name %>
                    </span>

                    <!-- Logout Form -->
                    <form
                        action="/auth/logout"
                        method="POST"
                    >
                        <button
                            type="submit"
                            class="rounded-lg border border-slate-200 px-3 py-1.5 font-medium text-slate-600 hover:bg-slate-50"
                        >
                            Log out
                        </button>
                    </form>

                </nav>

            <% } %>

        </div>

    </header>


    <!-- =========================
         MAIN CONTENT
         ========================= -->

    <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6">


        <!-- Success Message -->
        <% if (messages?.success?.length) { %>

            <div
                class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-emerald-800"
            >
                <%= messages.success[0] %>
            </div>

        <% } %>


        <!-- Error Message -->
        <% if (messages?.error?.length) { %>

            <div
                class="mb-6 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-rose-800"
            >
                <%= messages.error[0] %>
            </div>

        <% } %>