<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= product.name %> | Ecommerce Store</title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="min-h-screen bg-stone-50 text-slate-900">

    <!-- NAVBAR -->

    <header class="bg-white border-b border-stone-200">

        <div class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between">

            <a
                href="/products"
                class="text-2xl font-black tracking-tight text-slate-950"
            >
                ECOMMERCE<span class="text-orange-500">.</span>
            </a>

            <nav class="flex items-center gap-6 text-sm font-semibold">

                <a
                    href="/products"
                    class="text-slate-500 hover:text-orange-500 transition"
                >
                    Shop
                </a>

                <a
                    href="/orders"
                    class="text-slate-500 hover:text-orange-500 transition"
                >
                    My Orders
                </a>

                <a
                    href="/cart"
                    class="text-slate-500 hover:text-orange-500 transition"
                >
                    🛒 Cart
                </a>

            </nav>

        </div>

    </header>


    <!-- BREADCRUMB -->

    <div class="max-w-7xl mx-auto px-6 pt-8">

        <a
            href="/products"
            class="text-sm font-semibold text-slate-500 hover:text-orange-500 transition"
        >
            ← Back to Products
        </a>

    </div>


    <!-- PRODUCT SECTION -->

    <main class="max-w-7xl mx-auto px-6 py-10">

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">


            <!-- PRODUCT IMAGE -->

            <div class="bg-white rounded-3xl border border-stone-200 p-8 shadow-sm">

                <% if (product.imageUrl) { %>

                    <div class="aspect-square flex items-center justify-center overflow-hidden rounded-2xl bg-stone-50">

                        <img
                            src="<%= product.imageUrl %>"
                            alt="<%= product.name %>"
                            class="max-h-[520px] max-w-full object-contain hover:scale-105 transition duration-500"
                        >

                    </div>

                <% } else { %>

                    <div class="aspect-square rounded-2xl bg-stone-100 flex items-center justify-center">

                        <span class="text-6xl">
                            📦
                        </span>

                    </div>

                <% } %>

            </div>


            <!-- PRODUCT INFORMATION -->

            <div class="pt-2">


                <!-- CATEGORY -->

                <span class="inline-block px-4 py-1.5 rounded-full bg-orange-100 text-orange-700 text-xs font-bold uppercase tracking-wider">
                    <%= product.category %>
                </span>


                <!-- NAME -->

                <h1 class="text-4xl md:text-5xl font-black tracking-tight mt-5 leading-tight">
                    <%= product.name %>
                </h1>


                <!-- PRICE -->

                <div class="mt-6 flex items-end gap-3">

                    <span class="text-4xl font-black text-orange-500">
                        ₹<%= product.price %>
                    </span>

                    <span class="text-sm text-slate-400 mb-1">
                        Inclusive of all applicable taxes
                    </span>

                </div>


                <!-- DIVIDER -->

                <div class="border-t border-stone-200 my-8"></div>


                <!-- DESCRIPTION -->

                <div>

                    <h2 class="text-lg font-bold mb-3">
                        About this product
                    </h2>

                    <p class="text-slate-600 leading-7">
                        <%= product.description %>
                    </p>

                </div>


                <!-- STOCK -->

                <div class="mt-7">

                    <% if (product.stock > 0) { %>

                        <div class="inline-flex items-center gap-2 text-emerald-700 bg-emerald-50 px-4 py-2 rounded-lg text-sm font-bold">

                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>

                            In Stock —
                            <%= product.stock %>
                            available

                        </div>

                    <% } else { %>

                        <div class="inline-flex items-center gap-2 text-red-700 bg-red-50 px-4 py-2 rounded-lg text-sm font-bold">

                            <span class="w-2 h-2 rounded-full bg-red-500"></span>

                            Out of Stock

                        </div>

                    <% } %>

                </div>


                <!-- ADD TO CART -->

                <% if (product.stock > 0) { %>

                    <form
                        action="/cart/add/<%= product._id %>"
                        method="POST"
                        class="mt-8"
                    >

                        <button
                            type="submit"
                            class="w-full md:w-auto px-10 py-4 bg-slate-950 text-white rounded-xl font-bold text-lg hover:bg-orange-500 transition duration-300 shadow-lg"
                        >
                            🛒 Add to Cart
                        </button>

                    </form>

                <% } else { %>

                    <button
                        disabled
                        class="mt-8 w-full md:w-auto px-10 py-4 bg-slate-200 text-slate-400 rounded-xl font-bold text-lg cursor-not-allowed"
                    >
                        Currently Unavailable
                    </button>

                <% } %>


                <!-- PRODUCT BENEFITS -->

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-10">

                    <div class="bg-white border border-stone-200 rounded-xl p-4">

                        <div class="text-2xl mb-2">
                            🚚
                        </div>

                        <p class="font-bold text-sm">
                            Fast Delivery
                        </p>

                        <p class="text-xs text-slate-500 mt-1">
                            Quick doorstep delivery
                        </p>

                    </div>


                    <div class="bg-white border border-stone-200 rounded-xl p-4">

                        <div class="text-2xl mb-2">
                            🔒
                        </div>

                        <p class="font-bold text-sm">
                            Secure Payment
                        </p>

                        <p class="text-xs text-slate-500 mt-1">
                            Safe & secure checkout
                        </p>

                    </div>


                    <div class="bg-white border border-stone-200 rounded-xl p-4">

                        <div class="text-2xl mb-2">
                            ↩️
                        </div>

                        <p class="font-bold text-sm">
                            Easy Returns
                        </p>

                        <p class="text-xs text-slate-500 mt-1">
                            Hassle-free returns
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </main>


    <!-- FOOTER -->

    <footer class="border-t border-stone-200 mt-10 bg-white">

        <div class="max-w-7xl mx-auto px-6 py-8 flex flex-col sm:flex-row justify-between gap-4">

            <p class="text-sm text-slate-400">
                © 2026 Ecommerce Store
            </p>

            <div class="flex gap-5 text-sm">

                <a
                    href="/products"
                    class="text-slate-500 hover:text-orange-500"
                >
                    Shop
                </a>

                <a
                    href="/orders"
                    class="text-slate-500 hover:text-orange-500"
                >
                    My Orders
                </a>

                <a
                    href="/cart"
                    class="text-slate-500 hover:text-orange-500"
                >
                    Cart
                </a>

            </div>

        </div>

    </footer>

</body>

</html>