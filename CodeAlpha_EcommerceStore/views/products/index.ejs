<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Products</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-slate-100 text-slate-800">

  <!-- Navbar -->
  <nav class="border-b bg-white shadow-sm">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">

      <a href="/products" class="text-2xl font-bold text-slate-900">
        🛍️ My Store
      </a>

      <div class="flex items-center gap-4">
        <a href="/cart" class="font-semibold text-slate-600 transition hover:text-blue-600">
          🛒 Cart
        </a>

        <a href="/orders" class="font-semibold text-slate-600 transition hover:text-blue-600">
          Orders
        </a>

        <a href="/profile" class="font-semibold text-slate-600 transition hover:text-blue-600">
          Profile
        </a>
      </div>

    </div>
  </nav>

  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-slate-900 sm:text-4xl">
        Products
      </h1>

      <p class="mt-2 text-slate-500">
        Browse our latest products.
      </p>
    </div>

    <!-- Search and filters -->
    <form
      action="/products"
      method="GET"
      class="mb-8 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200"
    >
      <div class="grid gap-4 md:grid-cols-4">

        <div class="md:col-span-2">
          <label
            for="search"
            class="mb-2 block text-sm font-semibold text-slate-700"
          >
            Search Products
          </label>

          <input
            type="text"
            id="search"
            name="search"
            value="<%= search %>"
            placeholder="Search by product name..."
            class="w-full rounded-lg border border-slate-300 px-4 py-3 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100"
          >
        </div>

        <div>
          <label
            for="category"
            class="mb-2 block text-sm font-semibold text-slate-700"
          >
            Category
          </label>

          <select
            id="category"
            name="category"
            class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100"
          >
            <option value="">All Categories</option>

            <% categories.forEach(category => { %>
              <option
                value="<%= category %>"
                <%= selectedCategory === category ? "selected" : "" %>
              >
                <%= category %>
              </option>
            <% }) %>
          </select>
        </div>

        <div>
          <label
            for="sort"
            class="mb-2 block text-sm font-semibold text-slate-700"
          >
            Sort By
          </label>

          <select
            id="sort"
            name="sort"
            class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100"
          >
            <option value="" <%= selectedSort === "" ? "selected" : "" %>>
              Newest
            </option>

            <option value="low" <%= selectedSort === "low" ? "selected" : "" %>>
              Price: Low to High
            </option>

            <option value="high" <%= selectedSort === "high" ? "selected" : "" %>>
              Price: High to Low
            </option>
          </select>
        </div>

      </div>

      <div class="mt-5 flex flex-wrap gap-3">
        <button
          type="submit"
          class="rounded-lg bg-slate-900 px-6 py-3 font-semibold text-white transition hover:bg-slate-700"
        >
          🔍 Apply Filters
        </button>

        <a
          href="/products"
          class="rounded-lg border border-slate-300 bg-white px-6 py-3 font-semibold text-slate-700 transition hover:bg-slate-100"
        >
          Reset
        </a>
      </div>
    </form>

    <!-- Products -->
    <% if (products.length === 0) { %>

      <div class="rounded-2xl bg-white p-12 text-center shadow-sm ring-1 ring-slate-200">
        <div class="mb-4 text-5xl">
          📦
        </div>

        <h2 class="text-2xl font-bold text-slate-900">
          No Products Found
        </h2>

        <p class="mt-2 text-slate-500">
          Try changing your search or filter.
        </p>

        <a
          href="/products"
          class="mt-6 inline-block rounded-lg bg-slate-900 px-6 py-3 font-semibold text-white transition hover:bg-slate-700"
        >
          View All Products
        </a>
      </div>

    <% } else { %>

      <div class="mb-5">
        <p class="text-sm text-slate-500">
          Showing
          <span class="font-semibold text-slate-800">
            <%= products.length %>
          </span>
          product(s)
        </p>
      </div>

      <!-- Product grid -->
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">

        <% products.forEach(product => { %>

          <div
            class="group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200 transition duration-300 hover:-translate-y-1 hover:shadow-xl"
          >

            <a href="/products/<%= product._id %>">
              <div class="h-64 overflow-hidden bg-slate-100">

                <% if (product.imageUrl) { %>
                  <img
                    src="<%= product.imageUrl %>"
                    alt="<%= product.name %>"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                  >
                <% } else { %>
                  <div class="flex h-full items-center justify-center text-5xl text-slate-400">
                    📦
                  </div>
                <% } %>

              </div>
            </a>

            <div class="p-5">

              <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-blue-600">
                <%= product.category %>
              </p>

              <a href="/products/<%= product._id %>">
                <h2 class="line-clamp-2 min-h-[3.5rem] text-lg font-bold text-slate-900 transition hover:text-blue-600">
                  <%= product.name %>
                </h2>
              </a>

              <p class="mt-2 line-clamp-2 text-sm text-slate-500">
                <%= product.description %>
              </p>

              <div class="mt-4 flex items-center justify-between">
                <p class="text-2xl font-bold text-slate-900">
                  ₹<%= product.price %>
                </p>

                <p class="text-sm text-slate-500">
                  Stock: <%= product.stock %>
                </p>
              </div>

              <div class="mt-5">
                <a
                  href="/products/<%= product._id %>"
                  class="block rounded-lg bg-slate-900 px-4 py-3 text-center font-semibold text-white transition hover:bg-blue-600"
                >
                  View Product
                </a>
              </div>

            </div>
          </div>

        <% }) %>

      </div>

    <% } %>

  </main>

  <!-- Footer -->
  <footer class="mt-12 border-t bg-white">
    <div class="mx-auto max-w-7xl px-4 py-6 text-center text-sm text-slate-500 sm:px-6 lg:px-8">
      © 2026 My Store. All rights reserved.
    </div>
  </footer>

</body>

</html>